{
  "manifest_version": 3,
  "name": "Live PhishGuard",
  "version": "1.0",
  "description": "Enterprise-grade Phishing URL Detector",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open PhishGuard"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}